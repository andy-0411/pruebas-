<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Notas | Organiza tus ideas</title>
	<style>
		:root{--bg:#f5f7fb;--card:#fff;--text:#182230;--muted:#687386;--line:#e4e8f0;--primary:#5b5ce2;--soft:#eef0ff;--danger:#d94b62;--shadow:0 12px 30px #26345b12}
		*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px system-ui,-apple-system,Segoe UI,sans-serif}button,input,textarea{font:inherit}button{cursor:pointer;border:0}header{height:72px;background:var(--card);border-bottom:1px solid var(--line);display:flex;align-items:center;padding:0 5%;gap:28px}.logo{font-weight:800;font-size:21px;color:var(--primary);display:flex;align-items:center;gap:9px}.logo span{background:var(--primary);color:#fff;border-radius:9px;padding:6px 8px}header input{max-width:420px;flex:1;border:1px solid var(--line);border-radius:10px;padding:11px 15px;background:var(--bg);outline:none}header input:focus{border-color:var(--primary)}.avatar{margin-left:auto;background:#f5c17b;border-radius:50%;width:35px;height:35px;display:grid;place-items:center;font-weight:bold}
		.layout{display:grid;grid-template-columns:235px 1fr;min-height:calc(100vh - 72px)}aside{background:var(--card);border-right:1px solid var(--line);padding:30px 18px}nav{display:grid;gap:7px}nav button,.tag{background:transparent;text-align:left;padding:11px 14px;border-radius:9px;color:var(--muted)}nav button.active,nav button:hover{background:var(--soft);color:var(--primary);font-weight:600}.side-title{font-size:11px;text-transform:uppercase;color:#a0a8b7;letter-spacing:1px;margin:28px 14px 9px}.tag{display:flex;align-items:center;gap:9px;font-size:14px}.dot{width:9px;height:9px;border-radius:50%;background:#f4bd4e}.green{background:#5ac78c}.pink{background:#ed7595}.blue{background:#66a6e8}
		main{padding:34px 5%;max-width:1280px;width:100%;margin:auto}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}.top h1{margin:0 0 5px;font-size:28px}.top p{margin:0;color:var(--muted)}.primary{background:var(--primary);color:#fff;padding:12px 17px;border-radius:9px;font-weight:650;box-shadow:0 5px 12px #5b5ce233}.primary:hover{filter:brightness(.94)}.filters{display:flex;gap:10px;margin-bottom:20px;overflow:auto}.filters button{background:var(--card);border:1px solid var(--line);color:var(--muted);padding:8px 14px;border-radius:20px;white-space:nowrap}.filters button.active{background:var(--soft);border-color:#d7d8ff;color:var(--primary)}.notes{display:grid;grid-template-columns:repeat(auto-fill,minmax(245px,1fr));gap:18px}.note{background:var(--card);border:1px solid var(--line);border-top:4px solid #f4bd4e;border-radius:12px;padding:19px;min-height:190px;box-shadow:var(--shadow);position:relative;transition:.2s}.note:hover{transform:translateY(-3px)}.note h2{font-size:17px;margin:0 0 9px}.note p{color:var(--muted);line-height:1.55;margin:0 0 20px}.note footer{display:flex;justify-content:space-between;align-items:center;color:#9aa3b2;font-size:12px}.note small{background:#fff8e8;color:#bc8224;border-radius:5px;padding:4px 7px}.note.blue-border{border-color:#66a6e8}.note.green-border{border-color:#5ac78c}.note.pink-border{border-color:#ed7595}.more{color:#9aa3b2;background:none;font-size:20px}.empty{display:none;text-align:center;color:var(--muted);grid-column:1/-1;padding:50px}
		dialog{border:0;border-radius:15px;padding:0;width:min(500px,92%);box-shadow:0 20px 70px #18223040}dialog::backdrop{background:#18223066}.modal{padding:27px}.modal h2{margin:0 0 20px}.modal label{display:block;font-weight:600;margin:14px 0 6px}.modal input,.modal textarea,.modal select{width:100%;padding:11px;border:1px solid var(--line);border-radius:8px;outline:none}.modal textarea{resize:vertical;min-height:120px}.actions{display:flex;justify-content:flex-end;gap:10px;margin-top:22px}.cancel{background:#f0f2f6;color:var(--muted);padding:11px 16px;border-radius:8px}.toast{position:fixed;bottom:25px;right:25px;background:#182230;color:#fff;padding:13px 18px;border-radius:8px;display:none}
		@media(max-width:720px){header{padding:0 18px}header input{display:none}.layout{display:block}aside{display:none}main{padding:25px 18px}.top{align-items:flex-start;gap:15px}.top h1{font-size:24px}.primary{font-size:0;padding:12px}.primary:before{content:'+';font-size:21px}.notes{grid-template-columns:1fr}}
	</style>
</head>
<body>
	<header><div class="logo"><span>✓</span> Notas</div><input id="search" type="search" placeholder="Buscar notas..." aria-label="Buscar notas"><div class="avatar">P</div></header>
	<div class="layout">
		<aside><nav><button class="active" data-filter="all">▣ &nbsp; Todas las notas <b>12</b></button><button data-filter="favorite">★ &nbsp; Favoritas</button><button data-filter="archive">▤ &nbsp; Archivadas</button></nav><div class="side-title">Etiquetas</div><div class="tag"><i class="dot"></i> Trabajo</div><div class="tag"><i class="dot green"></i> Personal</div><div class="tag"><i class="dot pink"></i> Ideas</div><div class="tag"><i class="dot blue"></i> Estudio</div></aside>
		<main><section class="top"><div><h1>Mis notas</h1><p>Captura tus ideas y mantén todo organizado.</p></div><button class="primary" id="newNote">+ Nueva nota</button></section><div class="filters"><button class="active" data-category="all">Todas</button><button data-category="Trabajo">Trabajo</button><button data-category="Personal">Personal</button><button data-category="Ideas">Ideas</button><button data-category="Estudio">Estudio</button></div><section class="notes" id="notes"></section></main>
	</div>
	<dialog id="editor"><form class="modal" id="noteForm"><h2>Nueva nota</h2><label for="title">Título</label><input id="title" required placeholder="Escribe un título"><label for="content">Contenido</label><textarea id="content" required placeholder="Escribe tu nota..."></textarea><label for="category">Etiqueta</label><select id="category"><option>Trabajo</option><option>Personal</option><option>Ideas</option><option>Estudio</option></select><div class="actions"><button type="button" class="cancel" id="cancel">Cancelar</button><button class="primary">Guardar nota</button></div></form></dialog><div class="toast" id="toast">Nota guardada correctamente</div>
	<script>
		const notes=[{title:'Plan para el próximo proyecto',text:'Definir objetivos, fechas importantes y asignar tareas al equipo.',cat:'Trabajo',date:'Hoy, 10:30',color:''},{title:'Ideas para el blog',text:'Escribir sobre productividad, hábitos y herramientas digitales.',cat:'Ideas',date:'Ayer',color:'pink-border'},{title:'Lista de compras',text:'Café, leche, frutas, pan integral y verduras para la semana.',cat:'Personal',date:'12 Jun',color:'green-border'},{title:'Repasar JavaScript',text:'Funciones, promesas, async/await y manipulación del DOM.',cat:'Estudio',date:'10 Jun',color:'blue-border'}];
		const list=document.querySelector('#notes'), search=document.querySelector('#search');
		function render(){const q=search.value.toLowerCase(), cat=document.querySelector('.filters .active').dataset.category;list.innerHTML='';let result=notes.filter(n=>(cat==='all'||n.cat===cat)&&(n.title+n.text).toLowerCase().includes(q));result.forEach(n=>list.innerHTML+=`<article class="note ${n.color}" data-cat="${n.cat}"><h2>${n.title}</h2><p>${n.text}</p><footer><small>${n.cat}</small><span>${n.date} · <button class="more" aria-label="Más opciones">⋮</button></span></footer></article>`);if(!result.length)list.innerHTML='<div class="empty">No se encontraron notas.</div>'}
		document.querySelectorAll('.filters button').forEach(b=>b.onclick=()=>{document.querySelector('.filters .active').classList.remove('active');b.classList.add('active');render()});search.oninput=render;document.querySelector('#newNote').onclick=()=>editor.showModal();document.querySelector('#cancel').onclick=()=>editor.close();document.querySelector('#noteForm').onsubmit=e=>{e.preventDefault();notes.unshift({title:title.value,text:content.value,cat:category.value,date:'Ahora',color:''});editor.close();e.target.reset();render();toast.style.display='block';setTimeout(()=>toast.style.display='none',2200)};render();
	</script>
</body>
</html>
